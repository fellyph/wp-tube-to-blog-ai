{
	"name": "creatorstack-ai",
	"version": "1.0.0",
	"description": "AI toolkit for creator workflows in WordPress.",
	"author": {
		"name": "Fellyph Cintra",
		"url": "https://github.com/fellyph"
	},
	"private": true,
	"files": [
		"README.md",
		"readme.txt",
		"creatorstack-ai.php",
		"creatorstack-youtube-connector.php",
		"wp-tube-to-blog-ai.php",
		"uninstall.php",
		"assets",
		"build",
		"includes",
		"languages"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"i18n": "npm run build && npm run i18n:pot && npm run i18n:update-po && npm run i18n:mo && npm run i18n:json",
		"i18n:json": "wp i18n make-json languages languages --domain=creatorstack-ai --no-purge --pretty-print",
		"i18n:mo": "wp i18n make-mo languages",
		"i18n:pot": "wp i18n make-pot . languages/creatorstack-ai.pot --slug=creatorstack-ai --domain=creatorstack-ai --include=creatorstack-ai.php,creatorstack-youtube-connector.php,includes,src,build --exclude=languages --package-name='CreatorStack AI' --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/fellyph/creatorstack-ai/issues\",\"Language-Team\":\"LANGUAGE <LL@li.org>\"}'",
		"i18n:update-po": "wp i18n update-po languages/creatorstack-ai.pot languages",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"test": "npm run test:node && npm run test:e2e",
		"test:node": "node --test tests/node/*.test.mjs",
		"version:set": "node scripts/sync-version.mjs",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"test:e2e": "npm run build && playwright test",
		"test:e2e:ui": "npm run build && playwright test --ui",
		"test:e2e:debug": "npm run build && playwright test --debug",
		"playground:start": "npm run build && wp-playground-cli server --php=8.3 --wp=nightly --mount=.:/wordpress/wp-content/plugins/creatorstack-ai --blueprint=playground/blueprint.json --login",
		"playground:start:both": "npm run build && wp-playground-cli server --php=8.3 --wp=nightly --mount=.:/wordpress/wp-content/plugins/creatorstack-ai --mount=../ai-provider-for-google:/wordpress/wp-content/plugins/ai-provider-for-google --blueprint=playground/blueprint-both-plugins.json --login",
		"playground:debug": "npm run build && wp-playground-cli server --php=8.3 --wp=nightly --mount=.:/wordpress/wp-content/plugins/creatorstack-ai --blueprint=playground/blueprint.json --login --xdebug",
		"playground:check": "npm run build && wp-playground-cli run-blueprint --php=8.3 --wp=nightly --mount=.:/wordpress/wp-content/plugins/creatorstack-ai --blueprint=playground/blueprint.json --login",
		"playground:check:both": "npm run build && wp-playground-cli run-blueprint --php=8.3 --wp=nightly --mount=.:/wordpress/wp-content/plugins/creatorstack-ai --mount=../ai-provider-for-google:/wordpress/wp-content/plugins/ai-provider-for-google --blueprint=playground/blueprint-both-plugins.json --login",
		"playground:url": "node scripts/playground-url.mjs",
		"playground:url:source": "node scripts/playground-url.mjs playground/blueprint-github-source.json"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.0",
		"@wordpress/scripts": "^30.0.0",
		"@wp-playground/cli": "^3.1.0"
	}
}
