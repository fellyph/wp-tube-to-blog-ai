#: includes/class-settings.php:544
msgid "Automatic (recommended)"
msgstr "Automático (recomendado)"

#: includes/class-settings.php:565
msgid "Short"
msgstr "Corto"

#: includes/class-settings.php:566
msgid "About 600 to 900 words."
msgstr "Unas 600 a 900 palabras."

#: includes/class-settings.php:569
msgid "Medium"
msgstr "Medio"

#: includes/class-settings.php:570
